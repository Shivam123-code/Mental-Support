// KleverKlues Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================

enum UserRole {
  USER          // Regular users seeking support
  PROFESSIONAL  // Therapists, counselors, coaches
  ADMIN         // Platform administrators
  ENTERPRISE    // Organization accounts
  VENDOR        // Field responders / emergency support units
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  
  // Profile Information
  firstName         String?
  lastName          String?
  displayName       String?
  avatar            String?
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  language          String      @default("en")
  timezone          String      @default("UTC")
  
  // Privacy & Safety
  isAnonymous       Boolean     @default(false)
  emailVerified     Boolean     @default(false)
  phoneVerified     Boolean     @default(false)
  twoFactorEnabled  Boolean     @default(false)
  
  // Metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLoginAt       DateTime?
  
  // Relations
  profile           UserProfile?
  sessions          Session[]
  assessments       AssessmentResult[]
  programEnrollments ProgramEnrollment[]
  journalEntries    JournalEntry[]
  moodLogs          MoodLog[]
  bookings          Booking[]
  messages          Message[]
  communityPosts    CommunityPost[]
  notifications     Notification[]
  subscriptions     Subscription[]
  emergencyAlerts   EmergencyAlert[]
  vendorAssignments EmergencyAlert[] @relation("VendorAssignments")
  vendorProfile     VendorProfile?
  professionalApplications ProfessionalApplication[]
  organizationApplications OrganizationApplication[]
  passwordResetTokens PasswordResetToken[]
  paymentIntents    PaymentIntent[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Extended Profile
  bio                   String?
  location              String?
  occupation            String?
  emergencyContact      String?
  emergencyPhone        String?
  
  // Preferences
  notificationEmail     Boolean  @default(true)
  notificationPush      Boolean  @default(true)
  notificationSMS       Boolean  @default(false)
  
  // Wellbeing Preferences
  supportAreas          String[] // ["anxiety", "burnout", "relationships"]
  preferredLanguages    String[] @default(["en"])
  preferredSessionType  String?  // "video", "audio", "chat"
  
  // Privacy Settings
  profileVisibility     String   @default("private") // "public", "community", "private"
  showInDirectory       Boolean  @default(false)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// ============================================
// PROFESSIONAL PROFILES
// ============================================

enum ProfessionalType {
  THERAPIST
  PSYCHOLOGIST
  COUNSELOR
  COACH
  PSYCHIATRIST
  SOCIAL_WORKER
  MENTOR
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model Professional {
  id                    String              @id @default(cuid())
  userId                String              @unique
  
  // Professional Details
  type                  ProfessionalType
  licenseNumber         String?
  licenseState          String?
  licenseCountry        String?
  verificationStatus    VerificationStatus  @default(PENDING)
  verifiedAt            DateTime?
  
  // Qualifications
  qualifications        String[]
  specializations       String[]
  languages             String[]
  yearsOfExperience     Int?
  
  // Availability
  isAcceptingClients    Boolean             @default(true)
  hourlyRate            Float?
  currency              String              @default("USD")
  
  // Profile
  bio                   String?
  approach              String?
  displayName           String?
  profileImage          String?

  // Location (for auto-match proximity filtering)
  city                  String?
  state                 String?
  country               String              @default("India")
  region                String?             // e.g. "South India", "North India"

  // Demographics (for user preference matching)
  gender                String?             // "Male", "Female", "Non-binary", "Prefer not to say"

  // Session mode
  sessionModes          String[]            // ["Online", "In-person", "Both"]
  
  // Ratings
  averageRating         Float               @default(0)
  totalReviews          Int                 @default(0)
  totalSessions         Int                 @default(0)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  availability          ProfessionalAvailability[]
  bookings              Booking[]
  reviews               Review[]
  
  @@index([verificationStatus])
  @@index([type])
  @@index([city])
  @@index([state])
  @@index([region])
}

model ProfessionalAvailability {
  id              String       @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  
  dayOfWeek       Int          // 0 = Sunday, 6 = Saturday
  startTime       String       // "09:00"
  endTime         String       // "17:00"
  isAvailable     Boolean      @default(true)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([professionalId])
}

// ============================================
// ASSESSMENTS
// ============================================

enum AssessmentType {
  ANXIETY_INDEX
  BURNOUT_METER
  RELATIONSHIP_WELLNESS
  LEADERSHIP_EQ
  EMOTIONAL_WELLNESS
  WORKPLACE_WELLNESS
  STUDENT_WELLNESS
}

model AssessmentResult {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  assessmentType  AssessmentType
  score           Float
  maxScore        Float
  percentage      Float
  
  // Results
  level           String         // "Low", "Moderate", "High", "Severe"
  insights        Json           // Detailed insights and recommendations
  answers         Json           // User's answers
  
  // Metadata
  completedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  
  @@index([userId])
  @@index([assessmentType])
  @@index([completedAt])
}

// ============================================
// PROGRAMS
// ============================================

enum ProgramType {
  BURNOUT_RECOVERY
  ANXIETY_RESET
  SLEEP_RECOVERY
  EMOTIONAL_HEALING
  CONFIDENCE_REBUILD
  PARENTING_CONFIDENCE
  FOCUS_IMPROVEMENT
  RELATIONSHIP_HEALING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model ProgramEnrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  programType     ProgramType
  status          EnrollmentStatus @default(ACTIVE)
  
  // Progress
  currentWeek     Int              @default(1)
  completedWeeks  Int              @default(0)
  progressPercent Float            @default(0)
  
  // Dates
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  lastActivityAt  DateTime         @default(now())
  
  // Relations
  activities      ProgramActivity[]
  
  @@index([userId])
  @@index([status])
  @@index([programType])
}

model ProgramActivity {
  id              String            @id @default(cuid())
  enrollmentId    String
  enrollment      ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  
  week            Int
  activityTitle   String
  activityType    String            // "Video", "Reflection", "Exercise", "Audio"
  
  isCompleted     Boolean           @default(false)
  completedAt     DateTime?
  notes           String?
  
  createdAt       DateTime          @default(now())
  
  @@index([enrollmentId])
}

// ============================================
// JOURNAL & MOOD TRACKING
// ============================================

model JournalEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String?
  content         String
  mood            String?
  tags            String[]
  
  isPrivate       Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

model MoodLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mood            String   // "happy", "sad", "anxious", "calm", "stressed"
  intensity       Int      // 1-10
  notes           String?
  triggers        String[]
  activities      String[]
  
  loggedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([loggedAt])
}

// ============================================
// BOOKINGS & SESSIONS
// ============================================

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId    String
  professional      Professional   @relation(fields: [professionalId], references: [id])
  
  // Session Details
  sessionType       String         // "video", "audio", "chat"
  scheduledAt       DateTime
  duration          Int            // minutes
  status            BookingStatus  @default(PENDING)
  
  // Meeting Info
  meetingLink       String?
  meetingPassword   String?
  
  // Notes
  userNotes         String?
  professionalNotes String?
  
  // Payment
  amount            Float?
  currency          String         @default("USD")
  isPaid            Boolean        @default(false)
  
  // Metadata
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?
  
  @@index([userId])
  @@index([professionalId])
  @@index([scheduledAt])
  @@index([status])
}

model Review {
  id              String       @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userId          String

  /// The session being reviewed. Unique, and that uniqueness is the whole
  /// integrity story: one session yields one review, enforced by the database
  /// rather than by a check-then-insert that two tabs would both pass. Without
  /// it a professional's rating is whatever anybody types, as often as they
  /// like.
  ///
  /// ponytail: nullable rather than required, because making it required is a
  /// destructive migration on a live database and Postgres treats NULLs as
  /// distinct so the unique index is unaffected. Ceiling — the database alone
  /// would accept a review with no session behind it; POST /api/reviews is the
  /// only writer and always sets it. Upgrade path: once there is a migrations
  /// directory, backfill and make it `String` in a real migration.
  bookingId       String?      @unique

  rating          Float        // 1-5
  comment         String?
  isAnonymous     Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([professionalId])
  @@index([userId])
}

// ============================================
// COMMUNITY
// ============================================

enum PostType {
  DISCUSSION
  QUESTION
  STORY
  GRATITUDE
  SUPPORT_REQUEST
}

model CommunityPost {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            PostType   @default(DISCUSSION)
  title           String
  content         String
  tags            String[]
  
  isAnonymous     Boolean    @default(false)
  isModerated     Boolean    @default(false)
  
  likesCount      Int        @default(0)
  commentsCount   Int        @default(0)
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  comments        Comment[]
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Comment {
  id              String        @id @default(cuid())
  postId          String
  post            CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  
  content         String
  isAnonymous     Boolean       @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([postId])
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id              String   @id @default(cuid())
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  
  content         String
  isRead          Boolean  @default(false)
  readAt          DateTime?
  
  createdAt       DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  MESSAGE_RECEIVED
  PROGRAM_MILESTONE
  COMMUNITY_REPLY
  SYSTEM_ALERT
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            NotificationType
  title           String
  message         String
  link            String?
  
  isRead          Boolean          @default(false)
  readAt          DateTime?
  
  createdAt       DateTime         @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(TRIAL)
  
  startDate       DateTime           @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  
  amount          Float?
  currency        String             @default("USD")
  billingCycle    String?            // "monthly", "yearly"
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  @@index([userId])
  @@index([status])
}

// ============================================
// ANALYTICS & TRACKING
// ============================================

model ActivityLog {
  id              String   @id @default(cuid())
  userId          String?
  
  action          String   // "page_view", "assessment_completed", "session_booked"
  resource        String?  // Resource type
  resourceId      String?  // Resource ID
  metadata        Json?
  
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// GEOSPATIAL - HOSPITALS & EMERGENCY ALERTS
// ============================================

model Hospital {
  id          String   @id @default(cuid())
  name        String
  address     String
  phone       String
  email       String?

  // Geospatial fields
  latitude    Float
  longitude   Float
  location    Unsupported("geometry(Point, 4326)")?

  // Hospital details
  type        String   // "Government", "Private", "Clinic"
  specialties String[]
  beds        Int?
  hasER       Boolean  @default(false)
  is24x7      Boolean  @default(false)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([latitude, longitude])
}

model EmergencyAlert {
  id             String    @id @default(cuid())
  userId         String?                                       // nullable — guest SOS allowed
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Caller info (for guest / anonymous SOS)
  guestName      String?   // optional name if provided
  guestPhone     String?   // optional phone if provided

  // Location
  latitude       Float
  longitude      Float
  location       Unsupported("geometry(Point, 4326)")?
  // GPS accuracy in metres. A 1500m fix indoors means "search the block",
  // not "knock on this door" — responders need to see the difference.
  locationAccuracy  Float?
  // Bumped every time the caller streams a new position. A person fleeing or in
  // a vehicle is not where they were when they pressed the button.
  locationUpdatedAt DateTime?

  // Alert details
  severity       String    // "CRITICAL", "HIGH", "MEDIUM"
  message        String?
  status         String    @default("ACTIVE") // "ACTIVE", "ACKNOWLEDGED", "RESOLVED", "CANCELLED"

  // Response
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  // Set when the dispatch chain found nobody and a human was paged. An alert
  // that runs out of vendors must never simply stop.
  escalatedAt    DateTime?
  cancelledAt    DateTime?
  // A vendor marking RESOLVED is a claim, not proof. Until the caller confirms,
  // the case stays reviewable.
  resolutionConfirmedAt DateTime?

  // Vendor Dispatch
  assignedVendorId  String?                                      // which vendor was assigned
  assignedVendor    User?     @relation("VendorAssignments", fields: [assignedVendorId], references: [id])
  vendorAssignedAt  DateTime?                                    // when vendor was first alerted
  vendorAcceptedAt  DateTime?                                    // when vendor tapped Accept
  // PENDING | SEARCHING | VENDOR_ALERTED | VENDOR_ACCEPTED | EN_ROUTE | NEARBY
  // | ARRIVED | RESOLVED | ESCALATED | CANCELLED
  dispatchStatus    String    @default("PENDING")

  dispatchLogs   SosDispatchLog[]

  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([assignedVendorId])
  @@index([dispatchStatus])
  // Supports the bounding-box prefilter when finding nearby vendors, and the
  // "does this caller already have an open alert?" dedupe check.
  @@index([userId, status])
}

/// Append-only record of every dispatch decision for one alert.
///
/// Without this there is no answer to "why did help take twenty minutes" —
/// the alert row only shows the final state, not who was paged and ignored it.
/// Also the source of truth for vendor reliability stats.
model SosDispatchLog {
  id        String   @id @default(cuid())
  alertId   String
  alert     EmergencyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  vendorId  String?  // null for alert-level events (created, escalated, cancelled)
  // PINGED | ACCEPTED | DECLINED | TIMEOUT | ARRIVED | RESOLVED | ESCALATED
  // | NO_VENDORS | CANCELLED | CREATED | LOCATION_UPDATE | CALLER_OFFLINE
  event     String
  detail    String?
  distanceKm Float?

  createdAt DateTime @default(now())

  @@index([alertId])
  @@index([vendorId])
  @@index([event])
}

// ============================================
// VERIFICATION APPLICATIONS
// ============================================

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfessionalApplication {
  id                String            @id @default(cuid())

  // Personal Info
  firstName         String
  lastName          String
  email             String            @unique
  phone             String
  dateOfBirth       String
  gender            String
  address           String
  city              String
  state             String
  pincode           String

  // Qualifications
  highestDegree     String
  fieldOfStudy      String
  institution       String
  graduationYear    String
  licenseNumber     String
  licenseAuthority  String
  licenseExpiry     String
  specialty         String
  yearsOfExperience String

  // Profile
  bio               String            @db.Text
  languages         String            // JSON array as string
  consultationFee   String
  sessionTypes      String            // JSON array as string
  availability      String            @default("[]")

  // Document file paths (relative to /public/uploads/)
  licenseDocPath    String?
  degreeDocPath     String?
  idProofPath       String?
  profilePhotoPath  String?

  // Review
  status            ApplicationStatus @default(PENDING)
  adminNotes        String?
  rejectionReason   String?

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // After approval — linked user account
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
}

// ============================================
// VENDOR PROFILES
// ============================================

model VendorProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business Info
  businessName        String
  serviceType         String    // "First Responder" | "Mental Health Support" | "Security" | "Medical Aid" | "General Support"
  description         String?
  phone               String

  // Live location — updated from vendor dashboard each session
  latitude            Float?
  longitude           Float?
  locationUpdatedAt   DateTime?

  // Availability
  isOnline            Boolean   @default(false)  // vendor toggled ON in dashboard
  isAvailable         Boolean   @default(true)   // false when actively handling a case

  // Reliability counters, denormalised from SosDispatchLog for fast ranking.
  // Distance alone is the wrong sort key: a vendor who ignores every ping stays
  // permanently first in line just for being closest.
  pingCount           Int       @default(0)
  acceptCount         Int       @default(0)
  lastPingedAt        DateTime?

  // Contact channels for out-of-band dispatch. A socket emit only lands if a
  // browser tab is open, which for a responder on the move it usually is not.
  pushSubscription    String?   // Web Push subscription JSON
  smsOptOut           Boolean   @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isOnline])
  @@index([isAvailable])
  // Bounding-box prefilter: without this, finding nearby vendors scans every
  // online vendor and computes Haversine in JS for each one.
  @@index([isOnline, isAvailable, latitude, longitude])
}
model OrganizationApplication {
  id                  String            @id @default(cuid())

  // Organization Details
  orgName             String
  orgType             String
  registrationNumber  String
  website             String?
  email               String            @unique
  phone               String

  // Address
  address             String
  city                String
  state               String
  pincode             String

  // Contact Person
  contactName         String
  contactDesignation  String
  contactEmail        String
  contactPhone        String

  // Program Info
  employeeCount       String
  departments         String            // JSON array
  wellbeingPrograms   String            // JSON array
  additionalInfo      String?           @db.Text

  // Document paths
  regCertPath         String?
  gstCertPath         String?
  authLetterPath      String?
  logoPath            String?

  // Review
  status              ApplicationStatus @default(PENDING)
  adminNotes          String?
  rejectionReason     String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  userId              String?
  user                User?             @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
}

// ============================================
// PASSWORD RESET
// ============================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ============================================
// PROFESSIONAL LIBRARY & GROUPS
// ============================================

/// A worksheet, audio guide or handout published by a professional.
/// Previously a fixture in the professional dashboard, so nothing uploaded
/// existed and clients had no way to receive anything.
model Resource {
  id             String   @id @default(cuid())
  /// Professional.id of the author.
  professionalId String
  title          String
  category       String
  /// "PDF Guide", "Audio Sheet", "Interactive PDF", ...
  type           String
  description    String?
  /// Where the file lives. Null while a resource is drafted without an upload.
  url            String?
  /// Unpublished resources are visible only to their author.
  isPublished    Boolean  @default(true)
  downloads      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([professionalId])
  @@index([isPublished])
  @@index([category])
}

/// A recurring support circle, healing group or workshop run by a professional.
model SupportCircle {
  id             String   @id @default(cuid())
  professionalId String
  title          String
  description    String
  /// "Support Circle", "Healing Group", "Workshop"
  type           String
  /// Human schedule as the professional words it, e.g. "Wednesdays at 7:00 PM".
  scheduleLabel  String?
  /// Set for one-off sessions; recurring circles carry only scheduleLabel.
  scheduledAt    DateTime?
  capacity       Int      @default(15)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members        CircleMember[]

  @@index([professionalId])
  @@index([isActive])
}

/// One person's place in a circle. The unique pair is what stops a double join
/// silently inflating the count against capacity.
model CircleMember {
  id        String        @id @default(cuid())
  circleId  String
  circle    SupportCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime      @default(now())

  @@unique([circleId, userId])
  @@index([userId])
}

// ============================================
// PAYMENTS & PAID MATCHING
// ============================================

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  /// Paying for one booked session.
  BOOKING
  /// Paying to be matched with a professional and start care with them.
  AUTOMATCH
}

/// One attempt to take money, from creation to outcome.
///
/// Only the webhook may move this to PAID — never the browser. A client that
/// can flip its own payment status is a client that never has to pay, which is
/// why the dummy provider still round-trips a signed webhook rather than
/// returning success directly: the code path that runs today is the same one a
/// real gateway will drive.
model PaymentIntent {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose        PaymentPurpose
  /// Set for BOOKING. Null for AUTOMATCH — the caller has not chosen anybody yet.
  bookingId      String?

  /// Smallest currency unit (paise, cents). Floats do not belong in money.
  amount         Int
  currency       String         @default("INR")
  status         PaymentStatus  @default(CREATED)

  /// Which adapter issued this — "dummy" now, "razorpay" later.
  provider       String
  /// The provider's own id. Unique, so a replayed webhook cannot be mistaken
  /// for a second payment.
  providerRef    String         @unique

  /// Written once, by the webhook. Its presence is what makes fulfilment
  /// idempotent: a gateway will redeliver, and redelivery must be a no-op.
  paidAt         DateTime?
  /// Written when the entitlement is spent, so one payment buys one match.
  consumedAt     DateTime?
  failureReason  String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, purpose, status])
  @@index([bookingId])
  @@index([status])
}

/// A person is in this professional's care. Created when a paid auto-match is
/// spent on somebody, and it is what that payment actually buys: the pair can
/// message each other before any session is booked.
model CareRelationship {
  id              String    @id @default(cuid())
  userId          String
  professionalId  String

  /// "AUTOMATCH" | "MANUAL" — how the pair found each other.
  source          String    @default("AUTOMATCH")
  /// The intent that paid for it. Null for relationships an admin sets up.
  paymentIntentId String?
  /// Match score at the time, kept because the ranking will change underneath.
  matchPercent    Int?

  startedAt       DateTime  @default(now())
  /// Set when either side ends it. Nulled rows are the active ones.
  endedAt         DateTime?

  @@unique([userId, professionalId])
  @@index([professionalId, endedAt])
  @@index([userId, endedAt])
}
