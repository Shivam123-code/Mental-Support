// KleverKlues Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================

enum UserRole {
  USER          // Regular users seeking support
  PROFESSIONAL  // Therapists, counselors, coaches
  ADMIN         // Platform administrators
  ENTERPRISE    // Organization accounts
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  
  // Profile Information
  firstName         String?
  lastName          String?
  displayName       String?
  avatar            String?
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  language          String      @default("en")
  timezone          String      @default("UTC")
  
  // Privacy & Safety
  isAnonymous       Boolean     @default(false)
  emailVerified     Boolean     @default(false)
  phoneVerified     Boolean     @default(false)
  twoFactorEnabled  Boolean     @default(false)
  
  // Metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLoginAt       DateTime?
  
  // Relations
  profile           UserProfile?
  sessions          Session[]
  assessments       AssessmentResult[]
  programEnrollments ProgramEnrollment[]
  journalEntries    JournalEntry[]
  moodLogs          MoodLog[]
  bookings          Booking[]
  messages          Message[]
  communityPosts    CommunityPost[]
  notifications     Notification[]
  subscriptions     Subscription[]
  emergencyAlerts   EmergencyAlert[]
  
  @@index([email])
  @@index([role])
  @@index([status])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Extended Profile
  bio                   String?
  location              String?
  occupation            String?
  emergencyContact      String?
  emergencyPhone        String?
  
  // Preferences
  notificationEmail     Boolean  @default(true)
  notificationPush      Boolean  @default(true)
  notificationSMS       Boolean  @default(false)
  
  // Wellbeing Preferences
  supportAreas          String[] // ["anxiety", "burnout", "relationships"]
  preferredLanguages    String[] @default(["en"])
  preferredSessionType  String?  // "video", "audio", "chat"
  
  // Privacy Settings
  profileVisibility     String   @default("private") // "public", "community", "private"
  showInDirectory       Boolean  @default(false)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// ============================================
// PROFESSIONAL PROFILES
// ============================================

enum ProfessionalType {
  THERAPIST
  PSYCHOLOGIST
  COUNSELOR
  COACH
  PSYCHIATRIST
  SOCIAL_WORKER
  MENTOR
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model Professional {
  id                    String              @id @default(cuid())
  userId                String              @unique
  
  // Professional Details
  type                  ProfessionalType
  licenseNumber         String?
  licenseState          String?
  licenseCountry        String?
  verificationStatus    VerificationStatus  @default(PENDING)
  verifiedAt            DateTime?
  
  // Qualifications
  qualifications        String[]
  specializations       String[]
  languages             String[]
  yearsOfExperience     Int?
  
  // Availability
  isAcceptingClients    Boolean             @default(true)
  hourlyRate            Float?
  currency              String              @default("USD")
  
  // Profile
  bio                   String?
  approach              String?
  
  // Ratings
  averageRating         Float               @default(0)
  totalReviews          Int                 @default(0)
  totalSessions         Int                 @default(0)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  availability          ProfessionalAvailability[]
  bookings              Booking[]
  reviews               Review[]
  
  @@index([verificationStatus])
  @@index([type])
}

model ProfessionalAvailability {
  id              String       @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  
  dayOfWeek       Int          // 0 = Sunday, 6 = Saturday
  startTime       String       // "09:00"
  endTime         String       // "17:00"
  isAvailable     Boolean      @default(true)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([professionalId])
}

// ============================================
// ASSESSMENTS
// ============================================

enum AssessmentType {
  ANXIETY_INDEX
  BURNOUT_METER
  RELATIONSHIP_WELLNESS
  LEADERSHIP_EQ
  EMOTIONAL_WELLNESS
  WORKPLACE_WELLNESS
  STUDENT_WELLNESS
}

model AssessmentResult {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  assessmentType  AssessmentType
  score           Float
  maxScore        Float
  percentage      Float
  
  // Results
  level           String         // "Low", "Moderate", "High", "Severe"
  insights        Json           // Detailed insights and recommendations
  answers         Json           // User's answers
  
  // Metadata
  completedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  
  @@index([userId])
  @@index([assessmentType])
  @@index([completedAt])
}

// ============================================
// PROGRAMS
// ============================================

enum ProgramType {
  BURNOUT_RECOVERY
  ANXIETY_RESET
  SLEEP_RECOVERY
  EMOTIONAL_HEALING
  CONFIDENCE_REBUILD
  PARENTING_CONFIDENCE
  FOCUS_IMPROVEMENT
  RELATIONSHIP_HEALING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model ProgramEnrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  programType     ProgramType
  status          EnrollmentStatus @default(ACTIVE)
  
  // Progress
  currentWeek     Int              @default(1)
  completedWeeks  Int              @default(0)
  progressPercent Float            @default(0)
  
  // Dates
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  lastActivityAt  DateTime         @default(now())
  
  // Relations
  activities      ProgramActivity[]
  
  @@index([userId])
  @@index([status])
  @@index([programType])
}

model ProgramActivity {
  id              String            @id @default(cuid())
  enrollmentId    String
  enrollment      ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  
  week            Int
  activityTitle   String
  activityType    String            // "Video", "Reflection", "Exercise", "Audio"
  
  isCompleted     Boolean           @default(false)
  completedAt     DateTime?
  notes           String?
  
  createdAt       DateTime          @default(now())
  
  @@index([enrollmentId])
}

// ============================================
// JOURNAL & MOOD TRACKING
// ============================================

model JournalEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String?
  content         String
  mood            String?
  tags            String[]
  
  isPrivate       Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

model MoodLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mood            String   // "happy", "sad", "anxious", "calm", "stressed"
  intensity       Int      // 1-10
  notes           String?
  triggers        String[]
  activities      String[]
  
  loggedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([loggedAt])
}

// ============================================
// BOOKINGS & SESSIONS
// ============================================

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId    String
  professional      Professional   @relation(fields: [professionalId], references: [id])
  
  // Session Details
  sessionType       String         // "video", "audio", "chat"
  scheduledAt       DateTime
  duration          Int            // minutes
  status            BookingStatus  @default(PENDING)
  
  // Meeting Info
  meetingLink       String?
  meetingPassword   String?
  
  // Notes
  userNotes         String?
  professionalNotes String?
  
  // Payment
  amount            Float?
  currency          String         @default("USD")
  isPaid            Boolean        @default(false)
  
  // Metadata
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?
  
  @@index([userId])
  @@index([professionalId])
  @@index([scheduledAt])
  @@index([status])
}

model Review {
  id              String       @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userId          String
  
  rating          Float        // 1-5
  comment         String?
  isAnonymous     Boolean      @default(false)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([professionalId])
}

// ============================================
// COMMUNITY
// ============================================

enum PostType {
  DISCUSSION
  QUESTION
  STORY
  GRATITUDE
  SUPPORT_REQUEST
}

model CommunityPost {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            PostType   @default(DISCUSSION)
  title           String
  content         String
  tags            String[]
  
  isAnonymous     Boolean    @default(false)
  isModerated     Boolean    @default(false)
  
  likesCount      Int        @default(0)
  commentsCount   Int        @default(0)
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  comments        Comment[]
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Comment {
  id              String        @id @default(cuid())
  postId          String
  post            CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  
  content         String
  isAnonymous     Boolean       @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([postId])
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id              String   @id @default(cuid())
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  
  content         String
  isRead          Boolean  @default(false)
  readAt          DateTime?
  
  createdAt       DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  MESSAGE_RECEIVED
  PROGRAM_MILESTONE
  COMMUNITY_REPLY
  SYSTEM_ALERT
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            NotificationType
  title           String
  message         String
  link            String?
  
  isRead          Boolean          @default(false)
  readAt          DateTime?
  
  createdAt       DateTime         @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(TRIAL)
  
  startDate       DateTime           @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  
  amount          Float?
  currency        String             @default("USD")
  billingCycle    String?            // "monthly", "yearly"
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  @@index([userId])
  @@index([status])
}

// ============================================
// ANALYTICS & TRACKING
// ============================================

model ActivityLog {
  id              String   @id @default(cuid())
  userId          String?
  
  action          String   // "page_view", "assessment_completed", "session_booked"
  resource        String?  // Resource type
  resourceId      String?  // Resource ID
  metadata        Json?
  
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// GEOSPATIAL - HOSPITALS & EMERGENCY ALERTS
// ============================================

model Hospital {
  id          String   @id @default(cuid())
  name        String
  address     String
  phone       String
  email       String?

  // Geospatial fields
  latitude    Float
  longitude   Float
  location    Unsupported("geometry(Point, 4326)")?

  // Hospital details
  type        String   // "Government", "Private", "Clinic"
  specialties String[]
  beds        Int?
  hasER       Boolean  @default(false)
  is24x7      Boolean  @default(false)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([latitude, longitude])
}

model EmergencyAlert {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  latitude       Float
  longitude      Float
  location       Unsupported("geometry(Point, 4326)")?

  // Alert details
  severity       String    // "CRITICAL", "HIGH", "MEDIUM"
  message        String?
  status         String    @default("ACTIVE") // "ACTIVE", "ACKNOWLEDGED", "RESOLVED"

  // Response
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

